{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MuleTaskBlockSpec",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "slots": {
    "frame_id": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{4}$",
      "description": "Hexadecimal frame identifier for execution tracking."
    },
    "time_slot": {
      "type": "string",
      "enum": ["SLOT_1_FETCH", "SLOT_2_ROUTE", "SLOT_3_EXECUTE", "SLOT_4_JUDGE", "SLOT_5_VERIFY"],
      "description": "Deterministic hardware execution phase."
    },
    "subnet": {
      "type": "string",
      "pattern": "^10\\.[0-9]+\\.[0-9]+\\.0/24$",
      "description": "Virtual network subnet isolating the scene boundary."
    },
    "op": {
      "type": "string",
      "description": "The atomic operation to execute."
    },
    "target": {
      "type": "string",
      "pattern": "^%[A-Z][a-zA-Z0-9]*$",
      "description": "Unique scene node name prefixed with %."
    },
    "ref": {
      "type": "string",
      "pattern": "^10\\.[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Virtual IP host address assigned to the target node."
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit negative constraints and anti-patterns forbidden in this frame."
    }
  },
  "standard_exclusions": [
    "untyped_variables",
    "relative_paths_up_tree",
    "cross_subnet_queries",
    "freeform_code_blocks",
    "synthetic_transactions"
  ]
}
